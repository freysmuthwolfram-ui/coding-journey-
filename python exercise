import pandas as pd

max_amount = float('-inf')   # running max, starts at "nothing beats this from below"
max_chunk = None             # which chunk number it came from

for i, chunk in enumerate(pd.read_csv('transactions.csv', chunksize=1000), start=1):
    chunk_max = chunk['amount'].max()
    if chunk_max > max_amount:
        max_amount = chunk_max
        max_chunk = i

print(f"Max transaction: {max_amount} (found in chunk {max_chunk})")



'''names = ['Alice', 'Bob', 'Charlie']
ages = [30, 25, 35]
cities = ['NYC', 'LA', 'Chicago']
Produce a list of dictionaries like 
[{'name': 'Alice', 'age': 30, 'city': 'NYC'}, ...]
 using zip() only 
 (no list comprehension shortcuts that bypass zip).'''


names = ['Alice', 'Bob', 'Charlie']
ages = [30, 25, 35]
cities = ['NYC', 'LA', 'Chicago']

dict_list = list()

    
for nam, ag, cit in zip(names, ages, cities):
    dicti = {'name': nam, 'age': ag, 'city': cit}
    dict_list.append(dicti)
    

print(dict_list)


