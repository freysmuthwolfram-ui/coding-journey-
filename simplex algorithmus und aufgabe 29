import numpy as np

# ==========================================
# 1. Die Simplex-Funktion (Studenten-Version)
# ==========================================
def simplex(A, b, c, basis, pricing):
    A = np.array(A, dtype=float)
    b = np.array(b, dtype=float)
    c = np.array(c, dtype=float)
    m, n = A.shape
    B = list(basis)
    eps = 1e-9 
    
    for k in range(1000): # Max 1000 Iterationen
        # --- Schritt 1 ---
        N = [i for i in range(n) if i not in B]
        A_B = A[:, B]
        x_B = np.linalg.solve(A_B, b)
        
        x = np.zeros(n)
        for i in range(m):
            x[B[i]] = x_B[i]
            
        # --- Schritt 2 ---
        c_B = c[B]
        c_N = c[N]
        A_N = A[:, N]
        
        y = np.linalg.solve(A_B.T, c_B)
        c_tilde_N = c_N - A_N.T @ y
        
        # --- Schritt 3 & 4 ---
        if np.all(c_tilde_N >= -eps):
            B.sort()
            return x, B
            
        # --- Schritt 6 ---
        if pricing == 0:
            min_idx = np.argmin(c_tilde_N)
            r = N[min_idx]
        elif pricing == 1:
            r = -1
            for i in range(len(N)):
                if c_tilde_N[i] < -eps:
                    r = N[i]
                    break 
                    
        # --- Schritt 7 ---
        a_r = A[:, r]
        d = np.linalg.solve(A_B, a_r)
        
        # --- Schritt 8 & 9 ---
        if np.all(d <= eps):
            print("Problem ist unbeschränkt: STOP.")
            return None, None
            
        # --- Schritt 11 ---
        ratios = []
        for i in range(m):
            if d[i] > eps:
                ratios.append(x_B[i] / d[i])
            else:
                ratios.append(np.inf)
                
        t_hat = np.min(ratios)
        
        kandidaten_fuer_s = []
        for i in range(m):
            if d[i] > eps and abs((x_B[i] / d[i]) - t_hat) < eps:
                kandidaten_fuer_s.append(B[i])
                
        if pricing == 0:
            s = kandidaten_fuer_s[0]
        elif pricing == 1:
            s = min(kandidaten_fuer_s)
            
        # --- Schritt 12, 13, 14 ---
        for i in range(m):
            if B[i] == s:
                B[i] = r
                break

    print("Achtung: Maximale Iterationszahl erreicht (Mögliches Kreisen/Cycling!).")
    return x, B


