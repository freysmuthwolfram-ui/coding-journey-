"""
Implementierung des Simplex-Algorithmus (Algorithmus 4.7) nach Dantzig (1947).

Löst lineare Programme der Form:
    min  c^T x
    u.d.N.  A x = b
            x >= 0

Unterstützt zwei Pivot-Regeln:
    pricing = 0 : Regel der kleinsten reduzierten Kosten (Dantzig-Regel)
    pricing = 1 : Bland's Regel (kleinster Index - garantiert Terminierung)
"""

import numpy as np


def simplex(A, b, c, basis, pricing=0, max_iter=10000, tol=1e-9):
    """
    Simplex-Algorithmus zur Lösung von  min c^T x  u.d.N.  A x = b, x >= 0.

    Parameter
    ---------
    A : (m, n) array
        Koeffizientenmatrix (Zeilenrang m vorausgesetzt).
    b : (m,) array
        Rechte Seite.
    c : (n,) array
        Kostenvektor.
    basis : Liste/Array von m Indizes aus {0,...,n-1}
        Startbasis B_0 (0-indiziert). Die Spalten A[:, basis] müssen
        regulär sein und x_B = A_B^{-1} b >= 0 erfüllen (zulässige Basis).
    pricing : {0, 1}
        0 = kleinste reduzierte Kosten (Dantzig),
        1 = Bland's Regel.
    max_iter : int
        Abbruchschranke zur Sicherheit.
    tol : float
        numerische Toleranz.

    Rückgabe
    --------
    status : str
        "optimal", "unbounded" oder "max_iter".
    x : (n,) array
        Basislösung (bei "optimal" die Optimallösung).
    basis : Liste
        zugehörige Basis (sortiert).
    info : dict
        Zusatzinfos: Iterationszahl, Zielfunktionswert.
    """
    A = np.asarray(A, dtype=float)
    b = np.asarray(b, dtype=float).flatten()
    c = np.asarray(c, dtype=float).flatten()
    m, n = A.shape
    basis = list(basis)

    if len(basis) != m:
        raise ValueError(f"Basis muss {m} Indizes enthalten, hat aber {len(basis)}.")

    k = 0  # Iterationszähler
    while k < max_iter:
        # --- Schritt 1: Nicht-Basis-Menge bestimmen ---
        N = [j for j in range(n) if j not in basis]

        # --- aktuelle Basislösung x^k berechnen ---
        A_B = A[:, basis]
        try:
            x_B = np.linalg.solve(A_B, b)
        except np.linalg.LinAlgError:
            raise ValueError("Basismatrix A_B ist singulär.")

        x = np.zeros(n)
        x[basis] = x_B

        # Zulässigkeitsprüfung (für Debug-Zwecke)
        if np.any(x_B < -tol):
            raise ValueError(
                f"Basislösung nicht zulässig: x_B = {x_B}. "
                "Startbasis muss zulässig sein."
            )

        # --- Schritt 2: reduzierte Kosten c_N berechnen ---
        # c_N = c_N - A_N^T A_B^{-T} c_B
        c_B = c[basis]
        c_N = c[N]
        A_N = A[:, N]
        # y = A_B^{-T} c_B  (Simplex-Multiplikatoren)
        y = np.linalg.solve(A_B.T, c_B)
        reduced_costs = c_N - A_N.T @ y

        # --- Schritt 3 & 4: Optimalitätstest ---
        if np.all(reduced_costs >= -tol):
            return "optimal", x, sorted(basis), {
                "iterations": k,
                "objective": float(c @ x),
            }

        # --- Schritt 6: eintretende Variable r wählen ---
        if pricing == 0:
            # kleinste reduzierte Kosten (Dantzig-Regel)
            idx_in_N = int(np.argmin(reduced_costs))
            r = N[idx_in_N]
        elif pricing == 1:
            # Bland's Regel: kleinster Index mit negativen reduzierten Kosten
            candidates = [N[i] for i, rc in enumerate(reduced_costs) if rc < -tol]
            r = min(candidates)
        else:
            raise ValueError("pricing muss 0 oder 1 sein.")

        # --- Schritt 7: Suchrichtung d^k := A_B^{-1} a_r ---
        a_r = A[:, r]
        d = np.linalg.solve(A_B, a_r)

        # --- Schritt 8: Unbeschränktheitstest ---
        if np.all(d <= tol):
            return "unbounded", x, sorted(basis), {
                "iterations": k,
                "objective": -np.inf,
            }

        # --- Schritt 11: austretende Variable s und Schrittweite t_hat ---
        # t_hat := min_{i in B, d_i > 0} x_i / d_i
        ratios = []
        for i_pos, i_glob in enumerate(basis):
            if d[i_pos] > tol:
                ratios.append((x_B[i_pos] / d[i_pos], i_glob, i_pos))

        if not ratios:
            return "unbounded", x, sorted(basis), {
                "iterations": k,
                "objective": -np.inf,
            }

        t_hat = min(r[0] for r in ratios)

        if pricing == 0:
            # Aufgabe (I): "erster Basisindex s" - also kleinste Position in der Basis,
            # die das Minimum annimmt. Wir interpretieren "erster" als kleinster
            # globaler Index unter den Minimierern (deterministisch, stabil).
            tied = [ri for ri in ratios if abs(ri[0] - t_hat) < tol]
            s = min(tied, key=lambda ri: ri[1])[1]
        else:
            # Bland's Regel auch für austretende Variable:
            # kleinster Index s in B unter den Minimierern
            tied = [ri for ri in ratios if abs(ri[0] - t_hat) < tol]
            s = min(tied, key=lambda ri: ri[1])[1]

        # --- Schritt 12 & 13: Basisupdate ---
        basis.remove(s)
        basis.append(r)
        k += 1

    # Iterationsgrenze erreicht
    return "max_iter", x, sorted(basis), {
        "iterations": k,
        "objective": float(c @ x),
    }


# ============================================================
#  Tests / Beispiele
# ============================================================
if __name__ == "__main__":

    print("=" * 60)
    print("Beispiel 1: Einfaches 2D-LP in Standardform")
    print("=" * 60)
    # max  3 x1 + 2 x2   <=>   min  -3 x1 - 2 x2
    # u.d.N.  x1 + x2 <= 4
    #         x1 + 3 x2 <= 6
    #         x1, x2 >= 0
    #
    # Standardform mit Schlupfvariablen x3, x4:
    #   x1 + x2 + x3      = 4
    #   x1 + 3 x2    + x4 = 6
    A = np.array([
        [1, 1, 1, 0],
        [1, 3, 0, 1],
    ], dtype=float)
    b = np.array([4, 6], dtype=float)
    c = np.array([-3, -2, 0, 0], dtype=float)
    basis0 = [2, 3]  # Startbasis: Schlupfvariablen

    for p in [0, 1]:
        status, x, B, info = simplex(A, b, c, basis0, pricing=p)
        name = "Dantzig" if p == 0 else "Bland"
        print(f"\n  Pricing = {p} ({name}):")
        print(f"    Status     : {status}")
        print(f"    x*         : {x}")
        print(f"    Basis      : {B}")
        print(f"    Zielwert   : {info['objective']:.4f}")
        print(f"    Iterationen: {info['iterations']}")

    print("\n" + "=" * 60)
    print("Beispiel 2: Klassisches Lehrbuch-Beispiel")
    print("=" * 60)
    # min  -x1 - 2 x2
    # u.d.N.  -2 x1 + x2 + x3       = 2
    #         -x1 + 2 x2      + x4  = 7
    #         x1               + x5 = 3
    #         x >= 0
    A = np.array([
        [-2, 1, 1, 0, 0],
        [-1, 2, 0, 1, 0],
        [ 1, 0, 0, 0, 1],
    ], dtype=float)
    b = np.array([2, 7, 3], dtype=float)
    c = np.array([-1, -2, 0, 0, 0], dtype=float)
    basis0 = [2, 3, 4]

    status, x, B, info = simplex(A, b, c, basis0, pricing=0)
    print(f"\n  Status     : {status}")
    print(f"  x*         : {x}")
    print(f"  Basis      : {B}")
    print(f"  Zielwert   : {info['objective']:.4f}")
    print(f"  Iterationen: {info['iterations']}")

    print("\n" + "=" * 60)
    print("Beispiel 3: Unbeschränktes LP")
    print("=" * 60)
    # min  -x1 - x2
    # u.d.N.   x1 - x2 + x3 = 1
    #         -x1 + x2 + x4 = 1  (kein)
    # ... stattdessen ein klar unbeschränktes Problem:
    # min -x1,  x1 - x2 = 0,  x>=0   -> x1 kann beliebig wachsen mit x2 = x1
    A = np.array([
        [1, -1, 1],
    ], dtype=float)
    b = np.array([1], dtype=float)
    c = np.array([-1, -1, 0], dtype=float)
    basis0 = [2]

    status, x, B, info = simplex(A, b, c, basis0, pricing=0)
    print(f"\n  Status     : {status}")
    print(f"  Zielwert   : {info['objective']}")
    print(f"  Iterationen: {info['iterations']}")

    print("\n" + "=" * 60)
    print("Beispiel 4: Vergleich mit scipy.optimize.linprog")
    print("=" * 60)
    try:
        from scipy.optimize import linprog
        # Wiederhole Beispiel 1
        A_eq = np.array([
            [1, 1, 1, 0],
            [1, 3, 0, 1],
        ], dtype=float)
        b_eq = np.array([4, 6], dtype=float)
        c_vec = np.array([-3, -2, 0, 0], dtype=float)
        res = linprog(c_vec, A_eq=A_eq, b_eq=b_eq,
                      bounds=[(0, None)] * 4, method="highs")
        print(f"  scipy:     x* = {res.x}")
        print(f"  scipy:     fun = {res.fun:.4f}")

        status, x, B, info = simplex(A_eq, b_eq, c_vec, [2, 3], pricing=0)
        print(f"  eigene:    x* = {x}")
        print(f"  eigene:    fun = {info['objective']:.4f}")
    except ImportError:
        print("  (scipy nicht verfügbar)")
